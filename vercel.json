{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js", // Specify your main server file
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/index.js" // Route API requests to your server file
    },
    {
      "src": "/(.*)",
      "dest": "/backend/index.js" // Route other requests to your server file
    }
  ]
}
